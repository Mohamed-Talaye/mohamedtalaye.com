# Written by build.py. Edit it there, not here.
# The site is plain HTML. Nothing in this folder may run as a program.
Options -Indexes -ExecCGI
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

# Git files are never served, even if one ends up here by mistake.
RedirectMatch 404 /\.git

DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<Files "feed.xml">
  ForceType application/rss+xml
</Files>

# One address for the whole site: https, without www.
# The certificate checks in .well-known are left alone.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://mohamedtalaye.com%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/xml application/rss+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
